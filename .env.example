# OpenAI-совместимый vLLM-сервер с моделью PaddleOCR-VL, без завершающего "/"
VLLM_URL=http://localhost:8400
# API-ключ vLLM (если сервер запущен с --api-key)
VLLM_API_KEY=
MODEL_NAME=PaddlePaddle/PaddleOCR-VL

# Разрешение рендера страниц PDF
PDF_RENDER_DPI=300
# Таймаут одного запроса к vLLM, секунды
VLLM_REQUEST_TIMEOUT=60
# Число попыток на страницу
VLLM_MAX_RETRIES=3
# Пауза перед каждым запросом к vLLM, секунды (мягкое ограничение нагрузки)
VLLM_REQUEST_DELAY=3

HOST=0.0.0.0
PORT=9000
LOG_LEVEL=INFO
# Необязательно: путь к файлу логов (по умолчанию логи только в stdout)
LOG_FILE=
